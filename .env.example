# Copia este archivo como .env y cambia los valores. Nunca subas el .env al repositorio.

# Base de datos PostgreSQL del servicio (en producción: Neon)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coworkspace_access

# Puerto HTTP
PORT=3003

# Bus de eventos (en producción: Upstash Redis)
REDIS_URL=redis://localhost:6379

# Servicio de membresías (para validar el plan activo)
MEMBERSHIP_URL=http://localhost:3002

# Horas de validez de una credencial QR
CREDENTIAL_TTL_HOURS=24
